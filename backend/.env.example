# Copy to .env — NEVER commit .env (gitignored).
# Any OpenAI-compatible endpoint. OpenRouter (default) / Muse Spark gateway / OpenAI / local.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Model id used when the spawn form leaves "model" empty, e.g. anthropic/claude-haiku-5-5
LOFT_DEFAULT_MODEL=
# Optional: models for team planning and AI role writing (default: LOFT_DEFAULT_MODEL)
LOFT_PLANNER_MODEL=
LOFT_ROLE_MODEL=
LOFT_MAX_TURNS=40

# The repo your agents work in (tools are locked to this folder).
WORKSPACE_DIR=

# Network: 127.0.0.1 for Editor/desktop. Quest on Wi-Fi: 0.0.0.0 + a long random LOFT_TOKEN.
HOST=127.0.0.1
LOFT_TOKEN=

# Optional cloud board store (local file fallback when empty)
SUPABASE_URL=
SUPABASE_ANON_KEY=
