# Configuration lives in the REPO-ROOT .env (../.env), which the server and `npm run check` load.
# This file lists every variable. Real environment variables beat .env files.
# NEVER commit a real .env (gitignored).

# ---- LLM (required): any OpenAI-compatible endpoint. Agents, planner, role writer, voice intent. ----
AGENT_API_KEY=
AGENT_BASE_URL=https://your-provider.example/v1
AGENT_MODEL=
# Optional overrides (win over AGENT_*): LLM_API_KEY, LLM_BASE_URL, LOFT_DEFAULT_MODEL
# Optional per-job models (default: the model above):
# LOFT_PLANNER_MODEL=
# LOFT_ROLE_MODEL=
# LOFT_VOICE_MODEL=
# LOFT_MAX_TURNS=40

# ---- Voice: speech-to-text ----
# local = whisper.cpp on this machine (run backend/tools/setup-stt.sh once)
STT_PROVIDER=local
# STT_MODEL_PATH=          (default backend/data/stt/ggml-small.bin)
# WHISPER_BIN=             (default backend/data/stt/bin/whisper-cli, else whisper-cli on PATH)
# STT_LANGUAGE=auto        (auto detects English / Indonesian / mixed)
# openai = any OpenAI-compatible /audio/transcriptions (recommended in the cloud):
# STT_PROVIDER=openai
# STT_BASE_URL=https://api.openai.com/v1
# STT_API_KEY=
# STT_MODEL=whisper-1

# ---- Server ----
# The repo the agents work in (tools are locked to this folder).
WORKSPACE_DIR=
# Network: 127.0.0.1 for Editor/desktop. Quest on Wi-Fi or cloud: 0.0.0.0 + a long random LOFT_TOKEN.
HOST=127.0.0.1
LOFT_TOKEN=
# PORT=4101
# LOFT_DATA_DIR=           (roles, projects, worktrees, previews; default backend/data)
# PROJECTS_DIR=

# Optional cloud board store (local file fallback when empty)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Keep voice recordings locally for tools/stt-compare.js (off by default)
STT_SAVE_SAMPLES=
# Agents suggest one improvement after a finished task (set 0 to turn off)
LOFT_SUGGESTIONS=
